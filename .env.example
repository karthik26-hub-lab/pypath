# GEMINI_API_KEY: Required only for optional AI Mode features
# (AI Code Debugger, AI Spaced-Repetition Roadmap, and Interview Evaluator).
# All 13 video chapters, Visual Field Book, local roadmap, and Python 3.11 test runner work without an API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional model override for AI Mode when self-hosting (e.g. gemini-2.5-flash).
# GEMINI_MODEL="gemini-2.5-flash"

# PORT: Local server port (defaults to 3000).
# PORT=3000

# APP_URL: The URL where this app is hosted (optional for local dev).
APP_URL="http://localhost:3000"
